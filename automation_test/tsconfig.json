{
	"compilerOptions": {
		"lib": ["DOM", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["@playwright/test", "node"]
	},
	"include": ["./**/*.ts"],
	"exclude": ["node_modules", "playwright-report", "test-results"]
}
