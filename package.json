{
	"name": "modular-frontend-architecture",
	"type": "module",
	"private": false,
	"keywords": [
		"react",
		"micro-frontend",
		"module federation",
		"nx",
		"rspack"
	],
	"scripts": {
		"dev": "nx run-many -t dev -p @modular-frontend/ui-components @modular-frontend/shell --output-style=stream",
		"dev:mock": "nx run-many -t mock -p @modular-frontend/ui-components @modular-frontend/shell --output-style=stream",
		"test": "nx run-many -t test --output-style=stream",
		"test:shell": "nx run shell:test",
		"test:ui": "nx run ui-components:test",
		"test:mocks": "bunx rstest --config mocks/rstest.config.ts",
		"build": "nx run-many -t build",
		"build:prod": "nx run shell:build:prod",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"format": "bunx biome format .",
		"format:fix": "bunx biome format --write .",
		"e2e": "nx run @modular-frontend/automation-test:e2e",
		"e2e:chromium": "nx run @modular-frontend/automation-test:e2e:chromium",
		"e2e:report": "nx run @modular-frontend/automation-test:e2e:report"
	},
	"overrides": {
		"@rsbuild/core": "1.7.5",
		"@rspack/core": "1.7.11"
	},
	"workspaces": [
		"packages/**",
		"packages/libraries/**",
		"automation_test"
	],
	"dependencies": {
		"preact": "10.28.1",
		"tailwindcss": "4.1.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "20.3.0",
		"@commitlint/config-conventional": "20.3.0",
		"@playwright/test": "^1.59.1",
		"@rsbuild/plugin-preact": "1.7.2",
		"@rstest/core": "0.7.7",
		"@tailwindcss/cli": "4.1.18",
		"@tailwindcss/postcss": "4.1.18",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/preact": "3.2.4",
		"fast-glob": "^3.3.3",
		"jsdom": "27.4.0",
		"lefthook": "2.0.13",
		"msw": "2.12.7",
		"nx": "22.0.1",
		"postcss": "8.5.6",
		"postcss-loader": "8.2.0",
		"typescript": "5.9.3"
	}
}
