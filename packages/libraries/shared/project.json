{
	"name": "@modular-frontend/shared",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "packages/libraries/shared/src",
	"tags": ["type:lib", "scope:shared"],
	"targets": {
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "rstest",
				"cwd": "packages/libraries/shared"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bunx biome check .",
				"cwd": "packages/libraries/shared"
			}
		},
		"lint:fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bunx biome check --write .",
				"cwd": "packages/libraries/shared"
			}
		},
		"format": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bunx biome format .",
				"cwd": "packages/libraries/shared"
			}
		},
		"format:fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bunx biome format --write .",
				"cwd": "packages/libraries/shared"
			}
		}
	}
}
