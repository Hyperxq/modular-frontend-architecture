{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"npmScope": "modular-frontend",
	"useInferencePlugins": true,
	"tasksRunnerOptions": {
		"default": {
			"runner": "nx/tasks-runners/default",
			"options": {
				"cacheableOperations": ["build", "lint:fix", "format:fix"],
				"parallel": 3
			}
		}
	},
	"targetDefaults": {
		"dev": {
			"dependsOn": []
		},
		"mock": {
			"dependsOn": []
		}
	},
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**", "!{projectRoot}/build/**"]
	}
}
