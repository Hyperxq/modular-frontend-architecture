# Run `bun install` to auto-generate .env.development.local, .env.development,
# .env.mock and .env.production from this template via scripts/setup-env.ts.
# All variables prefixed with PUBLIC_ are exposed to the browser bundle.

# Base URL of the deployment.
# - In local dev: the ui-components MF dev server (http://localhost:3001)
# - In production: the Cloudflare Pages domain (https://modular-frontend.pages.dev)
#
# rsbuild uses this for two things:
#   1. assetPrefix — base URL for all shell static assets
#   2. MF remote URL — rsbuild appends /ui-components/mf at build time
#      (the ui-components dist is copied into shell/dist/ui-components/mf/ by CI)
PUBLIC_BUCKET_URL=http://localhost:3001

# Backend API gateway URL
PUBLIC_GATEWAY_BACKEND=https://your-api-gateway.example.com

# Enable MSW browser mocking (true | false)
PUBLIC_ENABLE_MOCKING=false

# Comma-separated list of MSW handler keys to bypass (leave empty to mock all)
PUBLIC_MSW_OMIT_KEYS=

# MSW behavior for unhandled requests (bypass | error | warn)
PUBLIC_MSW_ON_UNHANDLED=bypass
