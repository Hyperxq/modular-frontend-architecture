{
	"name": "web",
	"$schema": "./node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"tags": ["type:app", "scope:root"],
	"targets": {
		"dev:remote": {
			"executor": "nx:run-commands",
			"options": {
				"command": "nx run @modular-frontend/ui-components:dev",
				"readyWhen": "Federated types created correctly"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "nx run @modular-frontend/shell:dev"
			},
			"dependsOn": ["dev:remote"]
		},
		"mock:remote": {
			"executor": "nx:run-commands",
			"options": {
				"command": "nx run @modular-frontend/ui-components:mock",
				"readyWhen": "Federated types created correctly"
			}
		},
		"mock": {
			"executor": "nx:run-commands",
			"options": {
				"command": "nx run @modular-frontend/shell:mock"
			},
			"dependsOn": ["mock:remote"]
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"nx run @modular-frontend/ui-components:build",
					"nx run @modular-frontend/shell:build"
				],
				"parallel": false
			}
		},
		"build:wc": {
			"executor": "nx:run-commands",
			"options": {
				"command": "nx run @modular-frontend/ui-components:build"
			}
		},
		"e2e:servers": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"nx run @modular-frontend/ui-components:dev",
					"nx run @modular-frontend/shell:dev"
				],
				"parallel": true,
				"readyWhen": "Local:"
			}
		},
		"e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bunx bddgen && bunx playwright test",
				"cwd": "automation_test"
			},
			"dependsOn": ["e2e:servers"]
		},
		"e2e:chromium": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bunx bddgen && bunx playwright test --project=chromium",
				"cwd": "automation_test"
			},
			"dependsOn": ["e2e:servers"]
		}
	}
}
